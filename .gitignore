# Large model artifacts & caches
ollama/
model_cache/
huggingface_cache/

# Generated vector databases & large index files (Preserved locally, rebuilt via scripts)
data/rag_db/
data/vector_db/
*.faiss
*.index

# Large raw datasets & binaries
data/raw/*.json
data/processed/*.txt
data/processed/*.bin
!data/raw/.gitkeep
!data/processed/.gitkeep

# Frontend dependencies & build
node_modules/
dist/
build/

# Logs & temporary outputs
*.log
logs/
outputs/*.csv
outputs/*.png

# OS/editor
.DS_Store
