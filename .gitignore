# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Secrets & Environment
.env
.env.*
!.env.example

# Model checkpoints (Preserved locally, excluded from Git due to size)
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.bin
checkpoints/*.safetensors
*.gguf
